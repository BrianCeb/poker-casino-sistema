{
  "name": "panel-direccion",
  "version": "1.0.0",
  "description": "Panel de Direccion del torneo de poker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.casino.pokerdireccion",
    "productName": "Panel Direccion - Poker",
    "files": [
      "main.js",
      "backend/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
