# Cadena de conexion de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/poker_casino?retryWrites=true&w=majority

# Puerto local donde corre el backend embebido de ESTA app (no lo comparte con Caja)
PORT=4001

# Debe coincidir EXACTO con la clave escrita en renderer/index.html (DIRECCION_KEY)
DIRECCION_API_KEY=cambiar-esta-clave

BACKUP_DIR=./backups
